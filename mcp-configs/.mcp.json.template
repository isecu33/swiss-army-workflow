{
  "_comment": "Plantilla de servidores MCP del equipo. Copia lo que uséis a ~/.claude/settings.json (clave mcpServers) o a .mcp.json del proyecto. Rellena los valores {{...}} con secretos LOCALES; NO comitees credenciales reales.",
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{{GITHUB_TOKEN}}" }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "{{PROJECT_ROOT}}"]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "{{DATABASE_URL}}"]
    }
  }
}
