{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Plantilla del equipo. install.sh/install.ps1 sustituye {{CLAUDE_DIR}} por la ruta real de ~/.claude y mergea hooks, extraKnownMarketplaces y enabledPlugins en ~/.claude/settings.json sin borrar tu config previa.",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/scripts/cost-tracker.js\"",
            "description": "Registra tokens y coste estimado por sesion en ~/.claude/metrics/costs.jsonl (lo lee /cost-report)."
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_DIR}}/scripts/session-save.js\"",
            "description": "Guarda una migaja de sesion (cwd, branch, ultimo mensaje) para /resume-session."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": { "source": "github", "repo": "anthropics/claude-code" }
    },
    "superpowers-marketplace": {
      "source": { "source": "github", "repo": "obra/superpowers-marketplace" }
    },
    "cco": {
      "source": { "source": "github", "repo": "egorfedorov/claude-context-optimizer" }
    },
    "thedotmack": {
      "source": { "source": "github", "repo": "thedotmack/claude-mem" }
    }
  },
  "enabledPlugins": {
    "security-guidance@claude-code-plugins": true,
    "commit-commands@claude-code-plugins": true,
    "plugin-dev@claude-code-plugins": true,
    "frontend-design@claude-code-plugins": true,
    "claude-context-optimizer@cco": true,
    "claude-mem@thedotmack": true
  }
}
